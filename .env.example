# Copy to .env.local and fill in real values.
# Never commit .env.local or any real secrets / tokens.

# --- Required ---
AUTH_SECRET=
JWT_SECRET_KEY=
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=
NEXT_PUBLIC_APP_URL=http://localhost:3000
PUBLIC_BASE_URL=http://localhost:3000

# NextAuth (optional aliases used in some envs)
# AUTH_URL=http://localhost:3000
# NEXTAUTH_URL=http://localhost:3000
# NEXTAUTH_SECRET=

# --- Object storage (Storage V1–V3) ---
# Default (omit STORAGE_PROVIDER): LocalPrivateStorage under var/uploads
# (or UPLOAD_STORAGE_DIR). Local files are ephemeral on Vercel — use Blob in prod.
#
# STORAGE_PROVIDER=vercel-blob
# BLOB_READ_WRITE_TOKEN=   # from Vercel Blob store — NEVER commit this value
# UPLOAD_STORAGE_DIR=      # optional local root override for LocalPrivateStorage
#
# Migrate local → Blob (dev carry-over; idempotent, writes a manifest under var/):
#   npx tsx --tsconfig tsconfig.json -r dotenv/config scripts/migrate-local-to-blob.ts

# --- Optional integrations ---
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# PINECONE_API_KEY=
# STRIPE_SECRET_KEY=
# TELEGRAM_BOT_TOKEN=
# SENDGRID_API_KEY=
# RESEND_API_KEY=
# EMAIL_PROVIDER=
# EMAIL_SEND_DOMAIN=
# EMAIL_PHYSICAL_ADDRESS=
# EMAIL_UNSUB_SECRET=
